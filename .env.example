# ==============================================================================
# Template Global de Ambiente Local — cabral-governance-ai
#
# NÃO edite nem copie este arquivo manualmente em cada demo.
# No seu gMac / máquina local, rode apenas 1 comando na raiz do repositório:
#
#   ./scripts/sync_local_env.sh
#
# O script autentica/isola o Argolis em `.gcp/gcloud-argolis` (sem tocar no seu
# ~/.config/gcloud corporativo), gera o `/.env` da raiz com caminhos absolutos,
# descobre os Reasoning Engines e serviços Cloud Run ativos no GCP e materializa
# automaticamente `demos/<NN-slug>/.env` + `.state/agent_info.json` completos
# para cada demo (zero comentar/descomentar variáveis).
# ==============================================================================

# 1. Credenciais Isoladas do Argolis (preenchidas automaticamente pelo sync_local_env.sh)
CLOUDSDK_ACTIVE_CONFIG_NAME=argolis
# CLOUDSDK_CONFIG=/caminho/absoluto/cabral-governance-ai/.gcp/gcloud-argolis
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/absoluto/cabral-governance-ai/.gcp/gcloud-argolis/application_default_credentials.json
GOOGLE_CLOUD_QUOTA_PROJECT=cabral-governance-ai

# 2. Projeto GCP Padrão
PROJECT_ID=cabral-governance-ai
PROJECT_NUMBER=933727338685
ORG_ID=970548019292
GOOGLE_CLOUD_PROJECT=cabral-governance-ai
CLOUDSDK_CORE_PROJECT=cabral-governance-ai
REGION=us-central1

# 3. Modelo Gemini (SEMPRE global) vs. Região do Reasoning Engine (us-central1)
GOOGLE_GENAI_USE_VERTEXAI=True
MODEL_NAME=gemini-3.8-flash
MODEL_LOCATION=global
GOOGLE_CLOUD_LOCATION=global
VERTEX_AI_LOCATION=global
AGENT_LOCATION=global
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1

# 4. Defaults de Runtime ADK, mTLS (evita conflito com cert corp no gMac) e OTel GEAP
ADK_ENABLE_MCP_GRACEFUL_ERROR_HANDLING=1
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
GOOGLE_API_USE_MTLS_ENDPOINT=never
GOOGLE_API_PREVENT_AGENT_TOKEN_SHARING_FOR_GCP_SERVICES=false

GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
